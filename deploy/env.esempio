# Copia questo file in .env (accanto a dove lanci `python -m portineria`),
# compila i valori e proteggilo (Linux/Pi: chmod 600 .env). Non condividerlo mai
# e non committarlo: .env è già nel .gitignore.

# Token del bot Telegram: Telegram -> @BotFather -> /newbot. Vuoto = Telegram spento (resta l'edificio web).
TELEGRAM_TOKEN=
# Il tuo ID numerico Telegram: Telegram -> @userinfobot
TELEGRAM_USER_ID=

# Chiave per firmare gli ordini approvati (HMAC-SHA256). Non scriverla a mano: lancia
#   python3 -m portineria.chiave
# che la genera e la scrive qui senza mostrarla (vedi README).
ORDINI_HMAC_KEY=<CHIAVE_HMAC_DA_GENERARE>

# Motori degli agenti (facoltativi: senza, l'ufficio parte ma gli agenti non rispondono)
GEMINI_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_BIN=

# Cartella di lavoro dell'ufficio (vault, stato, app). Default: ~/ufficio
UFFICIO_DIR=

# Edificio 3D: indirizzo e porta su cui ascolta. Vuoto = edificio spento.
WEB_HOST=127.0.0.1
WEB_PORT=8090
